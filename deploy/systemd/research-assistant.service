[Unit]
Description=Research Assistant Flask Service
After=network.target neo4j.service redis-server.service

[Service]
WorkingDirectory=/opt/research-assistant/project
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/research-assistant/project/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 web_app.app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
